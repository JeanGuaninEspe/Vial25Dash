---
import MainLayout from '../layouts/main.astro';
import { ChartAreaInteractive } from '../components/ui/chart-area-interactive';
import { ChartTransito } from '../components/ui/chart-transito';
import { ChartRadialStacked } from '../components/ui/chart-radial-stacked';
import { SidebarLayout } from '../components/sidebar-layout';
import { DashboardWelcome } from '../components/dashboard-welcome';
---

<MainLayout title="Dashboard - Recaudacion Peajes">
	<SidebarLayout transition:persist 
		client:load
		title="Dashboard de Peajes"
		description="Sistema de monitoreo y análisis"
	>
		<DashboardWelcome client:load />
		<div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
			<div class="md:col-span-2 lg:col-span-2">
				<ChartAreaInteractive client:load />
			</div>
			<div class="md:col-span-2 lg:col-span-1">
				<ChartRadialStacked client:load />
			</div>
		</div>
		<ChartTransito client:load />
	</SidebarLayout>
</MainLayout>

